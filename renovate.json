{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "mergeConfidence:all-badges"
  ],
  "timezone": "Europe/Helsinki",
  "schedule": [
    "* * * * 0,6"
  ],
  "updateNotScheduled": false,
  "automergeSchedule": [
    "* * * * 0,6"
  ],
  "semanticCommits": "enabled",
  "ignorePaths": [
    "workspace-hack/**",
    "**/fixtures/**",
    "**/vendor/**"
  ],
  "addLabels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "crate"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "groupName": "extend allowed rust dependencies",
      "automerge": false
    },
    {
      "matchDepTypes": [
        "action"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "rust-toolchain"
      ],
      "matchDepTypes": [
        "toolchain"
      ],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
